# この内容を web/.env.local にコピーして値を埋める。
# 本番（Vercel）は同じ名前でプロジェクトの環境変数に設定する。

# --- 画面を開くための共通パスワード -----------------------------------------
SITE_PASSWORD=change-me

# --- Salesforce ---------------------------------------------------------------
SF_USERNAME=you@example.com
SF_PASSWORD=
SF_SECURITY_TOKEN=

# My Domain を使っている組織は <自分の組織>.my.salesforce.com を指定する。
# 未設定なら login.salesforce.com に接続する。
SF_LOGIN_DOMAIN=

# 対象の校舎名。MANAERP__Location__c と完全一致させる。
SF_LOCATION=

# --- 表示 ---------------------------------------------------------------------
# 画面のタイトル下に出す組織名。未設定なら何も出さない。
SITE_NAME=

# 一覧に出さない講師名をカンマ区切りで指定する（社員など割当対象外の人）。
EXCLUDED_TEACHERS=

# --- 〇×の印の保存先（本番のみ / 未設定ならローカルの .data/*.json を使う） ---
KV_REST_API_URL=
KV_REST_API_TOKEN=
